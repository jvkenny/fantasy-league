# No secret lives here — 1Password references only, resolved at launch.
#   op run --env-file .env -- python3 -m ffl.export
#
# Item "fantasy-football" (Dev vault) is an API_CREDENTIAL item, so the fields
# are ESPN's values under 1Password's built-in names rather than custom labels:
#   credential  -> espn_s2   (concealed, ~300 chars)
#   text        -> SWID      (~38 chars, brace-wrapped)
# Verify with the length check in README § Auth if a pull starts 401-ing.
LEAGUE_ID=582222
ESPN_S2=op://Dev/fantasy-football/credential
SWID=op://Dev/fantasy-football/text
